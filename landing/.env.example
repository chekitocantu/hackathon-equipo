# Copia este archivo como .env.local y pon tu llave real. .env.local no se sube a git.
# La usa solo el servidor local (npm run dev) para "Enlaza tu llamada"; nunca llega al navegador.
OPENROUTER_API_KEY=sk-or-tu-llave-aqui

# Notetaker (Vexa) para mandar el bot a la reunión de Meet. Llave en https://vexa.ai/account
VEXA_API_KEY=tu-llave-de-vexa
# Opcional: cambia la URL si Vexa se instala en un servidor propio (ej. http://localhost:18056).
VEXA_API_URL=https://api.cloud.vexa.ai

# Opcional: memoria de clientes en InsForge (guardar llamadas, "ya lo sabemos" y clientes similares).
# Si no las pones, se usan las del proyecto enlazado con `npx -y @insforge/cli link` (../.insforge/project.json).
# La API key es de administrador: solo la usa el servidor, nunca le pongas prefijo VITE_.
INSFORGE_URL=https://tu-proyecto.us-east.insforge.app
INSFORGE_API_KEY=tu-api-key-de-insforge

# Opcionales: modelos de OpenRouter para transcribir y para el agente.
OPENROUTER_MODELO_TRANSCRIPCION=openai/whisper-large-v3-turbo
OPENROUTER_MODELO_AGENTE=anthropic/claude-haiku-5.5
